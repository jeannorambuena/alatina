# =========================================
# Repo WordPress orientado a código
# Versionar SOLO código propio y archivos de proyecto
# =========================================

# 1) Ignorar todo por defecto
*

# 2) Permitir metadatos y docs del repo
!.gitignore
!README.md
!CHANGELOG.md
!DEPLOY.md
!PRODUCTION-CHECKLIST.md
!.github/
!.github/**

# OpenClaw skill snapshots permitidos
!docs/
!docs/openclaw-skills/
!docs/openclaw-skills/alatina-wordpress-publisher/
!docs/openclaw-skills/alatina-wordpress-publisher/SKILL.md

# 3) Permitir archivos de entorno reproducible
!.env.example
!docker-compose.yml
!scripts/
!scripts/**

# 4) Permitir wp-content, pero no todo su contenido
!wp-content/
!wp-content/**

# 5) Ignorar contenido dinámico / pesado / no versionable
wp-content/uploads/
wp-content/ai1wm-backups/
wp-content/cache/
wp-content/upgrade/
wp-content/backups/
wp-content/wflogs/
wp-content/debug.log
wp-content/gallery/

# 6) Ignorar plugins de terceros instalados localmente
wp-content/plugins/all-in-one-wp-migration/
wp-content/plugins/nextgen-gallery/

# 7) Permitir SOLO código propio del tema y plugins propios
!wp-content/themes/
!wp-content/themes/alatina-base/
!wp-content/themes/alatina-base/**

!wp-content/plugins/
!wp-content/plugins/alatina-school-calendar/
!wp-content/plugins/alatina-school-calendar/**

# 8) Seguridad: nunca subir config local
wp-config.php
wp-config-*.php

# 9) Base de datos: nunca versionar dumps
db/*.sql
db/*.gz
db/*.zip

# 10) Basura de sistema/editor
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.log
*.tmp
*.swp

# 11) Ruido local temporal
wp-content/themes/alatina-base/_restore-points/
wp-content/plugins/alatina-school-calendar/_restore-points/
wp-content/plugins/alatina-school-calendar/tools/

# 12) Python cache local
__pycache__/
**/__pycache__/
*.pyc
